{
  "name": "unmapped-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:codex": "vite build --config vite.codex.config.ts",
    "dev": "vite",
    "dev:codex": "vite --config vite.codex.config.ts",
    "docs:reference": "typedoc && node scripts/fixReferenceNavigationLinks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:sample": "node scripts/packSample.mjs",
    "preview": "vite preview",
    "stats:balance": "RUN_BALANCE_STATS=1 vitest run tests/diagnostics/balanceStatsReport.test.ts",
    "stats:climate": "RUN_CLIMATE_STATS=1 vitest run tests/diagnostics/climateStatsReport.test.ts",
    "stats:declarations": "node scripts/declarationInventory.mjs",
    "stats:escape": "RUN_ESCAPE_REACH_STATS=1 vitest run tests/diagnostics/escapeReachStatsReport.test.ts",
    "stats:escape-islands": "RUN_ISLAND_ESCAPE_REACH_STATS=1 vitest run tests/diagnostics/islandEscapeReachStatsReport.test.ts",
    "stats:docs": "node scripts/docStatus.mjs",
    "stats:history": "node scripts/historyStats.mjs",
    "stats:durations": "RUN_DURATION_STATS=1 vitest run tests/diagnostics/durationStatsReport.test.ts",
    "stats:lines": "node scripts/countLines.mjs",
    "stats:startup": "RUN_STARTUP_REACH_STATS=1 vitest run tests/diagnostics/startupReachStatsReport.test.ts",
    "stats:terrain": "RUN_TERRAIN_STATS=1 vitest run tests/diagnostics/terrainStatsReport.test.ts",
    "test": "vitest run",
    "test:climate": "RUN_CLIMATE_TESTS=1 vitest run tests/world-codex/climateSystem.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.7.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "prettier": "^3.5.0",
    "sharp": "^0.35.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}

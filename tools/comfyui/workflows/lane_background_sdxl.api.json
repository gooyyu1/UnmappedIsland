{
  "_comment": [
    "レーンの背景やカードの絵を作るワークフロー（ComfyUIのAPI形式）。",
    "ComfyUIの画面で保存したブラウザ形式（nodes/links）ではなく、/prompt へ直接POSTできる形式。",
    "$で始まる値は generate.py が差し替えるプレースホルダ。",
    "左右が繋がった絵が要るなら lane_background_sdxl_tiling.api.json の方を使う。"
  ],
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }
  },
  "18": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "ghibli watercolor_v0.2.safetensors",
      "strength_model": 0.8,
      "strength_clip": 0.8,
      "model": ["4", 0],
      "clip": ["4", 1]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "$positive", "clip": ["18", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "$negative", "clip": ["18", 1] }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "$width", "height": "$height", "batch_size": 1 }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "$seed",
      "steps": 25,
      "cfg": 8,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["18", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "$prefix", "images": ["8", 0] }
  }
}
